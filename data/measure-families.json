      "controls": ["prepost"], "ceiling": "D", "window": 14, "minDays": 3, "claims": false,
      "how": { "prepost": "Did it work: coverage before and after the setup" },
      "guard": [],
      "sources": ["connectors_health"], "sectors": [], "moves": [9, 10, 37, 48],
