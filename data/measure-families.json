{
  "v": 1,
  "note": "Every card is one kind of action. A family says the closest number that action can move, what that rolls up to, how a launch is fingerprinted, and which comparison is possible. Built only from the blocks below; a new family is a new entry, never new engine code.",
  "blocks": {
    "scope": ["products", "pages", "audience", "cities", "codes", "campaigns", "listings", "questions", "channel", "none"],
    "controls": ["holdout", "did", "tagged", "prepost"],
    "fingerprint": ["ticket", "campaign_name", "utm", "code", "product_list", "page_list", "audience_split", "city_list", "listing_list", "start_date"]
  },
  "families": [
    { "id": "paid_ads", "name": "Paid ads", "surface": "ads", "lever": "spend, targeting or creative on paid channels",
      "metric": { "key": "cpa_first", "name": "Cost per first order", "unit": "money", "lower": true },
      "alt": [{ "key": "roas", "name": "Return on ad spend", "unit": "x" }],
      "goal": "acquisition", "scope": "campaigns", "fingerprint": ["ticket", "campaign_name", "utm", "start_date"],
      "controls": ["holdout", "did", "tagged", "prepost"], "ceiling": "A", "window": 7, "minDays": 5, "claims": true,
      "how": { "holdout": "A Meta A/B test, or one region held out", "did": "The new ad set against the ad sets left as they were", "tagged": "Orders on the BR campaign’s link" },
      "guard": ["Spend stays inside the weekly limit", "Frequency under 3.5"],
      "sources": ["meta", "google", "shopify"], "sectors": ["creatives", "ads"], "moves": [20, 21, 23],
      "words": ["ad", "ads", "meta", "facebook", "instagram ad", "google ads", "campaign", "creative", "budget", "roas", "cpa", "cpm", "retarget", "performance max", "ad set", "statics", "ugc"] },

    { "id": "site", "name": "Site and checkout", "surface": "site", "lever": "copy, layout, offer placement or checkout on the store",
      "metric": { "key": "cvr", "name": "Visits that become an order", "unit": "%", "lower": false },
      "alt": [{ "key": "atc_rate", "name": "Add-to-cart rate", "unit": "%" }, { "key": "aov", "name": "Average order value", "unit": "money" }],
      "goal": "conversion", "scope": "pages", "fingerprint": ["ticket", "page_list", "start_date"],
      "controls": ["holdout", "did", "prepost"], "ceiling": "A", "window": 14, "minDays": 10, "claims": true,
      "how": { "holdout": "Half the visitors see the new version (an A/B split)", "did": "The changed pages against similar pages left as they were" },
      "guard": ["Checkout drop-off does not rise", "Average order value holds"],
      "sources": ["ga4", "shopify"], "sectors": ["storefront"], "moves": [12, 29, 30, 31, 32, 33, 34, 35, 36, 37],
      "words": ["page", "pdp", "product page", "landing", "homepage", "checkout", "cart", "copy", "popup", "upsell", "cross-sell", "cro", "conversion", "site", "opt-in", "bundle builder", "lead magnet", "quiz", "free tool", "calculator", "score"] },

    { "id": "messages", "name": "Customer messages", "surface": "messages", "lever": "email, WhatsApp, SMS or push to people who already know the brand",
      "metric": { "key": "rev_per_recipient", "name": "Revenue per person messaged", "unit": "money", "lower": false },
      "alt": [{ "key": "reorder_rate", "name": "Reorders by day 45", "unit": "%" }],
      "goal": "retention", "scope": "audience", "fingerprint": ["ticket", "campaign_name", "audience_split", "utm", "start_date"],
      "controls": ["holdout", "tagged", "prepost"], "ceiling": "A", "window": 21, "minDays": 7, "claims": true,
      "how": { "holdout": "10% of the list gets nothing; the gap between the groups is the lift", "tagged": "Orders from the message’s tracked link" },
      "guard": ["Unsubscribes and opt-outs stay normal", "Complaints"],
      "sources": ["klaviyo", "shopify"], "sectors": ["signals"], "moves": [4, 39, 40, 41, 42],
      "words": ["email", "whatsapp", "sms", "flow", "nudge", "lifecycle", "winback", "win-back", "reorder", "retention", "push", "klaviyo", "abandoned", "day 84", "replenish"] },

    { "id": "pricing", "name": "Price and offers", "surface": "price", "lever": "price, discount, bundle, subscription or offer terms",
      "metric": { "key": "rev_per_visitor", "name": "Revenue per visitor", "unit": "money", "lower": false },
      "alt": [{ "key": "aov", "name": "Average order value", "unit": "money" }, { "key": "margin_per_order", "name": "Margin per order", "unit": "money" }],
      "goal": "revenue", "scope": "products", "fingerprint": ["ticket", "code", "product_list", "start_date"],
      "controls": ["did", "tagged", "prepost"], "ceiling": "B", "window": 14, "minDays": 7, "claims": true,
      "how": { "did": "The offer on some products or cities first; the rest are the comparison", "tagged": "Orders using the offer’s own code" },
      "guard": ["Margin per order does not fall below the floor", "Refunds"],
      "sources": ["shopify"], "sectors": [], "moves": [7, 8],
      "words": ["price", "pricing", "discount", "offer", "bundle", "subscription", "subscribe", "coupon", "code", "free shipping", "sale", "mrp", "ladder", "trial pack"] },

    { "id": "listings", "name": "Marketplace listings", "surface": "listings", "lever": "titles, images, content or price on Amazon, Flipkart, Nykaa or quick commerce",
      "metric": { "key": "listing_orders", "name": "Orders from the listing per week", "unit": "count", "lower": false },
      "alt": [{ "key": "listing_rank", "name": "Search rank for the main term", "unit": "rank", "lower": true }],
      "goal": "marketplace", "scope": "listings", "fingerprint": ["ticket", "listing_list", "start_date"],
      "controls": ["did", "prepost"], "ceiling": "B", "window": 14, "minDays": 7, "claims": true,
      "how": { "did": "The changed listings against listings left as they were" },
      "guard": ["Listing stays approved", "Stock lasts the window"],
      "sources": ["marketplaces"], "sectors": ["catalog"], "moves": [38],
      "words": ["amazon", "flipkart", "nykaa", "blinkit", "zepto", "instamart", "listing", "asin", "marketplace", "a+ content", "quick commerce", "q-com"] },

    { "id": "search", "name": "Search and AI visibility", "surface": "search", "lever": "pages, structured data or citations so search engines and AI answers find the brand",
      "metric": { "key": "search_clicks", "name": "Search clicks to the touched pages", "unit": "count", "lower": false },
      "alt": [{ "key": "ai_named", "name": "AI answers that name the brand", "unit": "count" }],
      "goal": "discovery", "scope": "pages", "fingerprint": ["ticket", "page_list", "start_date"],
      "controls": ["did", "prepost"], "ceiling": "B", "window": 28, "minDays": 14, "claims": true,
      "how": { "did": "Pages rolled out in turns: the ones not yet changed are the comparison", "prepost": "The same questions asked again every week" },
      "guard": ["Rankings on existing pages hold"],
      "sources": ["ga4", "search_console", "live_watch"], "sectors": ["visibility"], "moves": [11, 13, 14, 15, 17, 18],
      "words": ["seo", "search", "schema", "structured data", "ai answer", "chatgpt", "perplexity", "gemini", "cited", "comparison page", "vs page", "programmatic", "listicle", "best of", "rank"] },

    { "id": "content", "name": "Content, social and creators", "surface": "content", "lever": "organic posts, video, creators or community",
      "metric": { "key": "tagged_orders", "name": "First orders from the tagged links and codes", "unit": "count", "lower": false },
      "alt": [{ "key": "tagged_visits", "name": "Visits from the tagged links", "unit": "count" }],
      "goal": "acquisition", "scope": "codes", "fingerprint": ["ticket", "utm", "code", "start_date"],
      "controls": ["tagged", "prepost"], "ceiling": "C", "window": 21, "minDays": 7, "claims": true,
      "how": { "tagged": "Each creator or post gets its own code or link; we count what carries it" },
      "guard": ["Negative comments"],
      "sources": ["shopify", "ga4"], "sectors": [], "moves": [16, 22, 24, 25, 44],
      "words": ["content", "post", "reel", "video", "social", "creator", "influencer", "ugc", "community", "blog", "lab notes", "youtube", "carousel", "story"] },

    { "id": "partners", "name": "Partners, PR and referral", "surface": "partners", "lever": "other brands, press, affiliates or customers bringing new people",
      "metric": { "key": "referred_orders", "name": "Orders from the partner or referral code", "unit": "count", "lower": false },
      "alt": [{ "key": "referred_visits", "name": "Visits from the partner link", "unit": "count" }],
      "goal": "acquisition", "scope": "codes", "fingerprint": ["ticket", "code", "utm", "start_date"],
      "controls": ["tagged", "prepost"], "ceiling": "C", "window": 28, "minDays": 7, "claims": true,
      "how": { "tagged": "Each partner, outlet or referrer has its own code or link" },
      "guard": [],
      "sources": ["shopify", "ga4"], "sectors": [], "moves": [19, 26, 43],
      "words": ["partner", "collab", "co-marketing", "pr", "press", "earned media", "referral", "refer", "ambassador", "affiliate"] },

    { "id": "offline", "name": "Offline and B2B", "surface": "offline", "lever": "events, field teams, retail, clinics, salons or sales outreach",
      "metric": { "key": "channel_orders", "name": "Orders or accounts from that channel", "unit": "count", "lower": false },
      "alt": [{ "key": "leads", "name": "Leads", "unit": "count" }, { "key": "city_orders", "name": "Online orders in the event cities", "unit": "count" }],
      "goal": "acquisition", "scope": "cities", "fingerprint": ["ticket", "code", "city_list", "start_date"],
      "controls": ["did", "tagged", "prepost"], "ceiling": "B", "window": 28, "minDays": 7, "claims": true,
      "how": { "did": "Online orders in the event cities against similar cities with no event", "tagged": "The event’s or rep’s own code" },
      "guard": [],
      "sources": ["report", "shopify"], "sectors": [], "moves": [27, 45, 46, 47],
      "words": ["event", "field", "on-ground", "store", "retail", "salon", "derm", "dermatologist", "clinic", "b2b", "outbound", "distributor", "kiosk", "sampling", "detailing", "trade"] },

    { "id": "foundations", "name": "Foundations", "surface": "data", "lever": "tracking, data, tools or processes that make everything else measurable",
